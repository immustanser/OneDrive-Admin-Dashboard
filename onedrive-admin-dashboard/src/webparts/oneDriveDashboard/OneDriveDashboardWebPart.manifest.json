  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
    "group": { "default": "Advanced" },
    "title": { "default": "OneDrive Dashboard" },
    "description": { "default": "Centralized dashboard to monitor and manage OneDrive usage across the tenant." },
    "officeFabricIconFontName": "CloudUpload",
    "properties": {
      "description": "Monitor and manage OneDrive usage across your Microsoft 365 tenant.",
      "useMockData": false,
      "apiBaseUrl": ""
    }
  }]
}
